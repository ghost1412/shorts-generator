# ShortsFlow Environment Configuration
# Rename this file to .env and fill in your keys.

# --- LLM Configuration ---
# To use Cloud APIs (Hugging Face):
HF_API_KEY=your_huggingface_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# To use Local LLMs (Ollama):
# Example: http://localhost:11434/api/chat
LOCAL_LLM_URL=

# --- Media Sourcing ---
PEXELS_API_KEY=your_pexels_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- SaaS Infrastructure (Supabase & Stripe) ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Rendering Settings ---
RENDER_TARGET=local # 'local', 'server', or 'github'
OUTPUT_DIR=samples
